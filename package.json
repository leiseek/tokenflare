{
  "name": "tokenflare",
  "version": "2.2.0",
  "private": true,
  "description": "Turn a decommissioned Android phone into a Codex / Claude Code vibe-coding status indicator.",
  "workspaces": [
    "server",
    "pwa",
    "e2e"
  ],
  "scripts": {
    "build": "npm run build -w server",
    "start": "npm run start -w server",
    "dev": "npm run dev -w server",
    "restart": "node scripts/restart.mjs && npm run start",
    "kill-port": "node scripts/restart.mjs",
    "test": "npm run test -w server",
    "test:e2e": "npm run test -w e2e",
    "shots": "node e2e/shot.mjs",
    "typecheck": "npm run typecheck -w server"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Tokenflare contributors",
  "license": "MIT",
  "homepage": "https://github.com/leiseek/tokenflare",
  "repository": {
    "type": "git",
    "url": "https://github.com/leiseek/tokenflare.git"
  },
  "bugs": {
    "url": "https://github.com/leiseek/tokenflare/issues"
  },
  "keywords": [
    "codex",
    "claude-code",
    "claude",
    "ai-coding",
    "status-indicator",
    "pwa",
    "android",
    "vibe-coding",
    "quota-monitor"
  ]
}
