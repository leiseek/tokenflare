{
  "name": "@tokenflare/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tokenflare host server: hook ingress, quota fetcher, state, REST + WebSocket, PWA host.",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "kill-port": "node ../scripts/restart.mjs",
    "prestart": "node ../scripts/restart.mjs",
    "start": "tsx src/index.ts",
    "predev": "node ../scripts/restart.mjs",
    "dev": "tsx watch src/index.ts",
    "test": "node --import tsx --test --test-reporter=spec"
  },
  "dependencies": {
    "https-proxy-agent": "^7.0.6",
    "socks-proxy-agent": "^10.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/ws": "^8.5.13",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
